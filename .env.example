# Local setup: copy this file to project_manage/.env and fill in your own values.
# Render: add these values to the service's Environment settings instead.
# Never commit the populated .env or real keys/passwords.
DEBUG=True
SECRET_KEY=
# Leave DATABASE_URL empty for local SQLite. Use the hosting database URL on Render.
DATABASE_URL=

# REQUIRED before migrations, including when using local SQLite.
# Generate once per environment after installing requirements:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the generated value below. Do not use the test-settings key.
# Use the same value on the web service and backup worker.
# Preserve it separately from the database: losing it makes salaries unreadable.
# Rotation: NEW_KEY,OLD_KEY (keep old keys to read existing records and backups).
SALARY_ENCRYPTION_KEYS=

# SMTP is required for emailed backups. Select recipients in IT Operations >
# Backups & Schedules; recipients are stored in the database, not here.
EMAIL_USE_CONSOLE=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=10

# Enable backups only after testing recovery and real mailbox delivery.
# Run a separate worker: python manage.py run_backup_jobs --loop
DB_BACKUP_ENABLED=False
DB_BACKUP_KEEP_LOCAL=False
DB_BACKUP_MAX_EMAIL_BYTES=15728640
# Optional private staging directory (outside media/static); otherwise private_backups.
# DB_BACKUP_DIR=/private/path/to/backups
# Optional paths to installed PostgreSQL client utilities:
# PG_DUMP_BIN=pg_dump
# PG_RESTORE_BIN=pg_restore

# Restore stays disabled during normal use. Maintenance mode does not stop traffic;
# the operator must drain requests and stop competing workers before recovery.
DB_RESTORE_ENABLED=False
DB_MAINTENANCE_MODE=False
DB_RESTORE_ALLOW_DIFFERENT_DATABASE=False

# Optional Azure/Azurite uploads. Leave blank for local media storage.
AZURE_CONNECTION_STRING=
AZURE_CONTAINER=media
